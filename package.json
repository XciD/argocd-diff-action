{
  "name": "argocd-diff-action",
  "version": "0.0.0",
  "private": true,
  "description": "ArgoCD Diff GitHub Action",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "pack": "ncc build",
    "test": "jest",
    "all": "npm run build && npm run format && npm run pack && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quizlet/argocd-diff-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup",
    "argocd"
  ],
  "author": "Quizlet",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^8.0.0",
    "@actions/tool-cache": "^1.7.2"
  },
  "devDependencies": {
    "@swc/core": "^1.10.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@vercel/ncc": "^0.38.4",
    "jest": "^30.2.0",
    "js-yaml": "^3.13.1",
    "prettier": "^3.0.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "undici": "^6.23.0"
  }
}
